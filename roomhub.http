### Variables
@baseUrl = http://localhost:5090
# Change to /api to exercise the original assignment routes.
@apiPath = /api/v1

### 1. Create room (expected: 201)
# @name createRoom
POST {{baseUrl}}{{apiPath}}/rooms
Content-Type: application/json

{
  "name": "Study room 1",
  "capacity": 10
}

###
@roomId = {{createRoom.response.body.$.id}}

### 2. Get room (expected: 200)
GET {{baseUrl}}{{apiPath}}/rooms/{{roomId}}

### 3. Missing room (expected: 404)
GET {{baseUrl}}{{apiPath}}/rooms/00000000-0000-0000-0000-000000000001

### 4. Create booking (expected: 201; keep dates in the future)
# @name createBooking
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 4
}

###
@bookingId = {{createBooking.response.body.$.id}}

### 5. Get booking (expected: 200)
GET {{baseUrl}}{{apiPath}}/bookings/{{bookingId}}

### 6. Active overlap (expected: 409)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "bogdan",
  "startUtc": "2030-01-10T11:00:00Z",
  "endUtc": "2030-01-10T13:00:00Z",
  "attendees": 4
}

### 7. Touching interval (expected: 201)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "bogdan",
  "startUtc": "2030-01-10T12:00:00Z",
  "endUtc": "2030-01-10T13:00:00Z",
  "attendees": 4
}

### 8. Longer than four hours (expected: 400)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-10T14:00:00Z",
  "endUtc": "2030-01-10T18:01:00Z",
  "attendees": 4
}

### 9. Booking in the past (expected: 400)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2000-01-10T10:00:00Z",
  "endUtc": "2000-01-10T11:00:00Z",
  "attendees": 4
}

### 10. Cancel booking at least 60 minutes before it starts (expected: 204)
# To test CancellationWindowClosed (409), create a booking starting less than an hour from now.
POST {{baseUrl}}{{apiPath}}/bookings/{{bookingId}}/cancel

### 11. Repeated cancellation (expected: 409)
POST {{baseUrl}}{{apiPath}}/bookings/{{bookingId}}/cancel

### 12. Reuse cancelled interval (expected: 201)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 4
}

### 13. Create another room (expected: 201)
# @name createRoom2
POST {{baseUrl}}{{apiPath}}/rooms
Content-Type: application/json

{
  "name": "Study room 2",
  "capacity": 10
}

###
@roomId2 = {{createRoom2.response.body.$.id}}

### 14. Same participant, second active booking that day (expected: 201)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 4
}

### 15. Third active booking, another room and interval (expected: 409)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-10T14:00:00Z",
  "endUtc": "2030-01-10T15:00:00Z",
  "attendees": 4
}

### 16. Same participant, different UTC start date (expected: 201)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-11T10:00:00Z",
  "endUtc": "2030-01-11T12:00:00Z",
  "attendees": 4
}

### 17. Missing room precedes business validation (expected: 404)
POST {{baseUrl}}{{apiPath}}/rooms/00000000-0000-0000-0000-000000000001/bookings
Content-Type: application/json

{}

### 18. Create a room with capacity greater than 10 (expected: 201)
# @name createLargeRoom
POST {{baseUrl}}{{apiPath}}/rooms
Content-Type: application/json

{
  "name": "Large study room",
  "capacity": 11
}

###
@largeRoomId = {{createLargeRoom.response.body.$.id}}

### 19. Large room, exactly two hours with one attendee (expected: 201)
POST {{baseUrl}}{{apiPath}}/rooms/{{largeRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "maria",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 1
}

### 20. Large room, two hours plus one tick (expected: 400)
POST {{baseUrl}}{{apiPath}}/rooms/{{largeRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "maria",
  "startUtc": "2030-01-10T13:00:00Z",
  "endUtc": "2030-01-10T15:00:00.0000001Z",
  "attendees": 1
}

### 21. Room with capacity 10, exactly four hours (expected: 201)
POST {{baseUrl}}{{apiPath}}/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "maria",
  "startUtc": "2030-01-10T14:00:00Z",
  "endUtc": "2030-01-10T18:00:00Z",
  "attendees": 1
}
